{
  "$schema": "https://raw.githubusercontent.com/diegosouzapw/OmniRoute/main/schema.json",
  "gateway": {
    "name": "AutoHire-OmniRoute-Gateway",
    "port": 8080,
    "fallbackStrategy": "quota-aware-cascade",
    "tokenCompression": {
      "enabled": true,
      "algorithm": "RTK+Caveman",
      "targetRatio": 0.65
    }
  },
  "providers": [
    {
      "id": "gemini-flash",
      "name": "Google Gemini 1.5 / 2.0 Flash",
      "priority": 1,
      "envKey": "GEMINI_API_KEY",
      "timeoutMs": 10000,
      "maxTokens": 4096
    },
    {
      "id": "openai-gpt4o",
      "name": "OpenAI GPT-4o-mini",
      "priority": 2,
      "envKey": "OPENAI_API_KEY",
      "timeoutMs": 12000,
      "maxTokens": 4096
    },
    {
      "id": "local-fail-safe",
      "name": "AutoHire Built-in Heuristic Viva Engine",
      "priority": 99,
      "isDeterministic": true,
      "offlineReady": true,
      "description": "Zero-dependency offline engine ensuring viva presentations never fail due to API limits or network drops"
    }
  ],
  "routes": {
    "/interview/dialogue": {
      "primary": "gemini-flash",
      "fallbacks": ["openai-gpt4o", "local-fail-safe"],
      "temperature": 0.7
    },
    "/ats/semantic-match": {
      "primary": "gemini-flash",
      "fallbacks": ["local-fail-safe"],
      "temperature": 0.2
    },
    "/dossier/synthesis": {
      "primary": "openai-gpt4o",
      "fallbacks": ["gemini-flash", "local-fail-safe"],
      "temperature": 0.3
    }
  }
}
